{
  "expo": {
    "name": "Moments",
    "slug": "MomentsInFrame",
    "scheme": "momentsinframe",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3223780a-fb0c-4ed9-85a8-aaea616ff37a",
      "enabled": true,
      "checkAutomatically": "NEVER"
    },
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentsinframe.app",
      "associatedDomains": ["applinks:momentsinframe.com"],
      "infoPlist": {
        "UIBackgroundModes": ["fetch"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow MomentsInFrame to use your camera to scan event QR codes and take selfies to find your photos."
      }
    },
    "android": {
      "splash": {
        "image": "./assets/android-splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.momentsinframe.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "momentsinframe.com",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MomentsInFrame to use your camera to scan event QR codes."
        }
      ],
      "./plugins/withBackgroundUpload",
      "./plugins/withExcludeFromBackup",
      "expo-updates",
      ["expo-build-properties", { "android": { "minSdkVersion": 26 }, "ios": { "deploymentTarget": "18.0" } }],
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MomentsInFrame to save photos to your gallery.",
          "savePhotosPermission": "Allow MomentsInFrame to save photos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow MomentsInFrame to access your contacts to add co-admins."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/Logo.png",
          "color": "#000000",
          "androidMode": "default",
          "androidCollapsedTitle": "MomentsInFrame"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3223780a-fb0c-4ed9-85a8-aaea616ff37a"
      }
    }
  }
}
